{
  "name": "global-time-atlas",
  "version": "1.0.0",
  "description": "Bilingual, DST-aware timezone converter with live views for 956 major cities and 195 national capitals. Runs entirely in your browser.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "catalog": "node scripts/build-city-catalog.mjs",
    "test": "node scripts/validate-timezones.mjs",
    "test:browser": "playwright test",
    "test:all": "npm run test && npm run test:browser",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "city-timezones": "^1.3.4",
    "countries-and-timezones": "^3.10.0",
    "country-json": "^2.3.0",
    "typescript": "^5",
    "world-countries": "^5.1.0"
  }
}
